//Profile config names for nf-core/configs
params {
  config_profile_description = 'Cluster profile for medair (local cluster of Clinical Genomics Gothenburg)'
  config_profile_contact     = 'Clinical Genomics, Gothenburg'
  config_profile_url         = 'https://www.scilifelab.se/units/clinical-genomics-goteborg/'
}

//Nextflow parameters
singularity {
    // fix scratch and proxy
    runOptions = '--no-mount tmp -B /tmp:/tmp ' \
        + '--env http_proxy=http://nyabud.net.gu.se:8080 ' \
        + '--env https_proxy=http://nyabud.net.gu.se:8080 ' \
        + '--env ftp_proxy=http://nyabud.net.gu.se:8080 ' \
        + '--env no_proxy=.medair.lcl,slims2.sa.gu.se,.vgregion.se,10. '
    cacheDir = "/apps/bio/dependencies/nf-core/singularities"
}

profiles {

  routine {
    process {
      queue                  = 'routine.q'
      executor               = 'sge'
      penv                   = 'mpi'
      process.clusterOptions = '-S /bin/bash -l excl=1'
      params.max_cpus        = 32
      params.max_time        = 48.h
      params.max_memory      = 128.GB
    }
  }

  development {
    process {
      queue                  = 'development.q'
      executor               = 'sge'
      penv                   = 'mpi'
      process.clusterOptions = '-S /bin/bash -l excl=1'
      params.max_cpus        = 32
      params.max_time        = 480.h
      params.max_memory      = 128.GB
    }
  }

  pipeline {
    // Cleanup on exit
    cleanup = true

    process {
      // Enable working in TMPDIR
      scratch      = true
      stageInMode  = 'copy'
      stageOutMode = 'move'  

      cpus   = {  1    * task.attempt }
      memory = {  6.GB * task.attempt }

      errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
      maxRetries    = 2
      maxErrors     = '-1'

      resourceLimits = { [
        cpus: params.max_cpus,
        memory: params.max_memory,
        time: params.max_time
      ]}

      // Process-specific resource requirements
      withLabel:process_single {
        cpus   = {  1     * task.attempt }
        memory = {  24.GB * task.attempt }
        time   = {  4.h   * task.attempt }
      }
      withLabel:process_low {
        cpus   = {  2     * task.attempt }
        memory = {  24.GB * task.attempt }
        time   = {  8.h   * task.attempt }
      }
      withLabel:process_medium {
        cpus   = {  16    * task.attempt }
        memory = {  48.GB * task.attempt }
        time   = {  16.h  * task.attempt }
      }
      withLabel:process_high {
        cpus   = {  64    * task.attempt }
        memory = {  96.GB * task.attempt }
        time   = {  36.h  * task.attempt }
      }
      withLabel:process_long {
        time   = {  36.h  * task.attempt }
      }
    }
  }
}
